# =============================================================================
# SLU OrgDesk - environment template
# Copy to `.env` for local Docker Compose:
#     cp .env.example .env
# On Cloud Run these are injected from Secret Manager (see deploy/deploy.sh).
# NEVER commit the real .env file.
# =============================================================================

# -----------------------------------------------------------------------------
# MongoDB Atlas
# -----------------------------------------------------------------------------
# Full SRV connection string, including credentials.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=Web-Tech

# -----------------------------------------------------------------------------
# Node API service
# -----------------------------------------------------------------------------
NODE_ENV=production
# Local Compose publishes the API on this port. Cloud Run overrides PORT with 8080.
PORT=5000
# Comma-separated allow-list of browser origins for direct (non-proxied) calls.
# When requests arrive through the web container's reverse proxy this is unused.
CORS_ORIGINS=http://localhost,http://localhost:8080

# -----------------------------------------------------------------------------
# Sessions
# -----------------------------------------------------------------------------
# MUST be a long random string. Generate with:
#   openssl rand -hex 48
SESSION_SECRET=replace-me-with-a-48-byte-random-hex-string
# Set to `true` when the browser reaches the app over HTTPS (Cloud Run).
COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# Reverse proxy wiring (web container -> Node container)
# -----------------------------------------------------------------------------
# Upstream URL the Apache proxy forwards /api/* to.
#   Docker Compose : http://api:5000
#   Cloud Run      : https://<node-service>-<hash>-<region>.run.app
NODE_API_URL=http://api:5000

# -----------------------------------------------------------------------------
# Shared secret between the proxy and the Node API.
# Leave empty to disable the check (local development default).
# In production set this to a random value and store it in Secret Manager so
# that only the proxy can reach the Node API.
# -----------------------------------------------------------------------------
INTERNAL_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# PHP
# -----------------------------------------------------------------------------
# 1 when the visitor uses HTTPS, so PHP marks its session cookie Secure.
PHP_SESSION_COOKIE_SECURE=0
