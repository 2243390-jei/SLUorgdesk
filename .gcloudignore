# =============================================================================
# Cloud Build source-upload filter.
#
# `gcloud builds submit` uploads this directory as the Docker build context.
# Without this file gcloud synthesises one from .gitignore, which risks either
# uploading node_modules / .git or - worse - excluding paths the Dockerfiles
# COPY. This list mirrors .dockerignore so local and remote builds see the same
# context.
#
# Explicitly NOT ignored (both Dockerfiles copy these):
#   index.php, public/, php-server/, node-server/,
#   uploads/.htaccess, uploads/redirect.php, docker/
# =============================================================================

# Version control and CI noise
.git
.gitignore
.github

# Node dependencies - reinstalled inside the image with `npm ci`
node_modules
**/node_modules

# Secrets: injected at runtime from Secret Manager, never uploaded or baked in
.env
.env.*
**/.env
**/.env.*
!**/.env.example
**/client_secret*.json
**/*.pem
**/*.key

# Data exports - user records, including plaintext passwords. Never upload these
# to Cloud Build; import them from a machine that can reach the database.
data/

# Local runtime data - lives in Cloud Storage, mounted as a volume
# uploads/ mixes application code with user data. redirect.php and .htaccess are
# the access-control guard for submitted documents and MUST stay in the build
# context, otherwise the deployed image serves uploads with no guard at all.
#
# `uploads/*` rather than `uploads/**`: excluding the children leaves the uploads/
# directory entry in place, whereas `uploads/**` caused Cloud Build to drop the
# directory and fail with "COPY failed: stat uploads/: file does not exist".
# Keep this list in sync with .dockerignore.
uploads/*
!uploads/.htaccess
!uploads/redirect.php
public/images/orgs/*

# Editor / OS noise
.vscode
.idea
Thumbs.db
Desktop.ini
*.log
README.txt
